{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tank-duel",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./client",
    "binding": "ASSETS",
    "run_worker_first": ["/ws", "/health"]
  },
  "durable_objects": {
    "bindings": [{ "name": "LOBBY", "class_name": "Lobby" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Lobby"] }],
  "routes": [{ "pattern": "tanks.dreamteamhub.ca", "custom_domain": true }],
  "observability": { "enabled": true }
}
